# All values optional — defaults shown.

# Port for the local OAuth redirect listener (http://localhost:<port>/callback)
OAUTH_CALLBACK_PORT=8976

# Web UI (npm run web). HOST=127.0.0.1 keeps it reachable from this machine
# only (it acts with your Swiggy/Zomato login); set 0.0.0.0 to expose it.
HOST=127.0.0.1

# Port for the web UI
PORT=3000

# Cache TTL for search results, in seconds
CACHE_TTL_SECONDS=300

# Zomato data source: "live" (real MCP server, needs npm run login:zomato)
# or "mock" (fixtures/zomato/*.json snapshots, shows a SAMPLE DATA banner)
PLATFORM_ZOMATO=live
